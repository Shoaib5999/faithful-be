# Server
PORT=5001
NODE_ENV=production

# Database (Supabase Postgres)
# Pooled connection (Supavisor, IPv4-compatible) — used at runtime by Prisma Client.
# Required on Railway (and most PaaS): the direct :5432 host is IPv6-only and
# unreachable from networks without IPv6 egress.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true"
# Direct connection — used only by `prisma migrate` (schema migrations require a
# non-pooled connection). Get both from Supabase Dashboard → Project Settings → Database.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres"

# Redis (caching — product/category/etc. read-through cache, see src/config/redis.js)
# Railway: Project → New → Database → Add Redis, then set this to ${{Redis.REDIS_URL}}
# Leave unset to run with caching disabled (falls back to direct DB reads).
REDIS_URL=redis://default:password@host:6379

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# MSG91 (phone number OTP login/signup — see src/config/msg91.js)
# MSG91 dashboard → OTP → your DLT-approved template (required for India, external approval)
# Leave unset to run with phone login disabled (returns a clear 503, doesn't crash).
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_approved_template_id

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://www.faithfulmeat.com/api/auth/google/callback

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL=https://your-r2-public-url.example.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto

# Email - Resend
RESEND_API_KEY=your_resend_api_key_here
# Sender must use your verified domain (Resend cannot send from @gmail.com)
RESEND_FROM="Faithful Meat <noreply@faithfulmeat.com>"
# Your real inbox — contact form, notifications, and reply-to on outgoing mail
CONTACT_INBOX=hello@faithfulmeat.com

# Frontend (OAuth redirects, email links)
FRONTEND_URL=http://localhost:5123

# Comma-separated browser origins allowed to call this API
CORS_ALLOWED_ORIGINS=https://faithfulmeat.com,http://localhost:5173

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Set true to use Razorpay Magic Checkout (requires Magic enabled on Razorpay account)
# Also accepts legacy typo ENABLE_MEGIC_CHECKOUT
ENABLE_MAGIC_CHECKOUT=false
# Razorpay Dashboard → Magic Checkout → Platform Setup → Custom E-Commerce:
#   Shipping info:  https://www.faithfulmeat.com/api/payments/magic/shipping-info
#   Get promotions: https://www.faithfulmeat.com/api/payments/magic/promotions
#   Apply promo:    https://www.faithfulmeat.com/api/payments/magic/promotions/apply

# UPI
UPI_VPA=yourname@upi
UPI_MERCHANT_NAME=Faithful Meat

# Shiprocket
SHIPROCKET_EMAIL=your-shiprocket-api-email@example.com
SHIPROCKET_PASSWORD='your-shiprocket-api-password'
SHIPROCKET_CHANNEL_ID=your_shiprocket_channel_id_here

# ntfy push notifications (shop staff phone alert on new order placed)
# Pick a hard-to-guess topic name — anyone who knows it can read/publish to it on public ntfy.sh.
NTFY_TOPIC=your_ntfy_topic_here
# Only needed for a self-hosted ntfy server. Leave unset to use https://ntfy.sh.
# NTFY_BASE_URL=https://ntfy.sh
# Optional: admin panel deep link sent as the notification's click action.
# Use {orderId} as a placeholder, or omit it to have the id appended as a path segment.
# Leave unset to send notifications without a click URL.
# ADMIN_ORDER_URL=https://admin.faithfulmeat.com/orders/{orderId}

# Store Info (used in emails + Shiprocket orders)
STORE_NAME=Faithful Meat
STORE_EMAIL=hello@faithfulmeat.com
STORE_PHONE=9999999999
STORE_ADDRESS=Your Store Address
STORE_CITY=Mumbai
STORE_STATE=Maharashtra
STORE_PINCODE=400001
STORE_COUNTRY=India

ADMIN_EMAIL=admin@faithfulmeat.com
ADMIN_PASSWORD=change_me_on_first_login
